{
  "//": "El MISMO gate, con el emulado móvil por defecto de Lighthouse: un teléfono de gama media con 4G lenta y 4× de ralentización de CPU. Es el caso que decide, no el portátil del equipo.",
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3141/",
        "http://127.0.0.1:3141/register",
        "http://127.0.0.1:3141/precios"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      },
      "outputDir": "./.lighthouseci-movil"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      },
      "//outputDir": "Se asevera sobre el mismo directorio en el que se midió."
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-movil"
    }
  }
}
