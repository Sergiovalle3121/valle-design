{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "fixtures/generators/**/*.ts",
    "fuzz/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
