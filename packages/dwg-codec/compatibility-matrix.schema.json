{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valle-design:dwg-compatibility-matrix:1.0.0",
  "title": "Valle DWG v1 compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "matrixVersion",
    "updatedAt",
    "productionAvailable",
    "activationPolicy",
    "classRegistryComplete",
    "versions",
    "directions",
    "families",
    "evidenceRecords",
    "coverage"
  ],
  "properties": {
    "$schema": {
      "const": "./compatibility-matrix.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "matrixVersion": {
      "const": "v1"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "productionAvailable": {
      "const": false
    },
    "activationPolicy": {
      "const": "all-nine-together"
    },
    "classRegistryComplete": {
      "const": false,
      "$comment": "Promotion remains blocked until an authorized technical class registry and exact class/property coverage replace this scope-only matrix."
    },
    "versions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AC1009",
          "AC1012",
          "AC1014",
          "AC1015",
          "AC1018",
          "AC1021",
          "AC1024",
          "AC1027",
          "AC1032"
        ]
      }
    },
    "directions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["read", "write"]
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "evidenceRecords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/coverage"
      }
    }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "factId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "version": {
      "enum": [
        "AC1009",
        "AC1012",
        "AC1014",
        "AC1015",
        "AC1018",
        "AC1021",
        "AC1024",
        "AC1027",
        "AC1032"
      ]
    },
    "direction": {
      "enum": ["read", "write"]
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "properties"],
      "properties": {
        "id": {
          "$ref": "#/$defs/portableId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portableId"
          }
        }
      }
    },
    "familyPropertySelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "propertyIds"],
      "properties": {
        "familyId": {
          "$ref": "#/$defs/portableId"
        },
        "propertyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portableId"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "versionCodes",
        "directions",
        "familyProperties",
        "sourceIds",
        "artifactPath",
        "artifactSha256",
        "artifactByteLength",
        "producer",
        "tool",
        "independent",
        "reviewer",
        "reviewedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/factId"
        },
        "kind": {
          "enum": [
            "fixture",
            "round-trip",
            "independent-reader",
            "independent-writer",
            "fuzz",
            "benchmark",
            "e2e"
          ]
        },
        "versionCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/direction"
          }
        },
        "familyProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/familyPropertySelector"
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/factId"
          }
        },
        "artifactPath": {
          "type": "string",
          "pattern": "^evidence/sha256/[a-f0-9]{64}\\.(?:bin|dwg|json)$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "independent": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionCodes",
        "directions",
        "familyProperties",
        "status",
        "factIds",
        "evidenceIds",
        "rationale"
      ],
      "properties": {
        "versionCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/direction"
          }
        },
        "familyProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/familyPropertySelector"
          }
        },
        "status": {
          "enum": [
            "not-started",
            "research-ready",
            "implemented",
            "verified",
            "not-applicable"
          ]
        },
        "factIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/factId"
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/factId"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["research-ready", "implemented"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
