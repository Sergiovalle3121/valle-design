@@ -0,0 +1,69 @@
+/**
+ * LA PANTALLA TRAS EL ALTA, EN ASERCIONES.
+ *
+ * Tres contratos que un cambio con prisa rompe sin que nadie lo vea:
+ *
+ *   1. El texto dice «Cuenta creada» (lo buscan las suites reales en la región
+ *      `role="status"`), a QUÉ correo se envió, QUÉ hacer (abrirlo para
+ *      activar la cuenta) y DÓNDE mirar (correo no deseado). Y no promete
+ *      «entrarás directo»: tras verificar hay que iniciar sesión.
+ *   2. El botón de reenvío espera 60 s DESDE QUE APARECE la pantalla. El clic
+ *      reflejo en el segundo cero era el origen de los dos correos en el mismo
+ *      minuto que veía cada usuario nuevo.
+ *   3. NADIE reenvía solo. El único llamador de `resendVerification` es el
+ *      `onResend` del botón; no hay `useEffect` en la pantalla.
+ *
+ * Se mira el código fuente porque el runner no tiene DOM y porque el contrato
+ * 3 es sobre lo que el fichero NO contiene.
+ *
+ * Correr:  npx tsx src/components/check-your-inbox.spec.ts
+ */
+import { strict as assert } from "node:assert";
+import { readFileSync } from "node:fs";
+import { INBOX_COPY, RESEND_WAIT_SECONDS } from "../lib/check-your-inbox";
+
+/** El spec corre con el cwd en `apps/web`. */
+const fuente = readFileSync("src/components/CheckYourInbox.tsx", "utf8");
+const sinComentarios = fuente
+  .replace(/\/\*[\s\S]*?\*\//g, "")
+  .replace(/^\s*\/\/.*$/gm, "");
+
+// 1 · El texto.
+const frase = `${INBOX_COPY.created} ${INBOX_COPY.sentTo} X${INBOX_COPY.action}`;
+assert.match(frase, /^Cuenta creada\./u, "las suites reales buscan «Cuenta creada»");
+assert.match(frase, /Te enviamos un correo a X/u);
+assert.match(frase, /ábrelo para activar tu cuenta/u);
+assert.match(frase, /correo no deseado/u);
+assert.doesNotMatch(frase, /entrarás directo/u, "promesa falsa: tras verificar se inicia sesión");
+assert.match(INBOX_COPY.resent, /los anteriores siguen valiendo/u);
+for (const texto of Object.values(INBOX_COPY)) {
+  assert.doesNotMatch(texto, /\b(email|inbox|spam|resend|click)\b/iu, `texto en inglés: ${texto}`);
+}
+assert.match(sinComentarios, /INBOX_COPY\.created/u, "la pantalla usa el texto compartido");
+assert.match(sinComentarios, /INBOX_COPY\.resent/u, "tras reenviar se dice que los anteriores valen");
+assert.match(sinComentarios, /message=\{/u, "el texto va en la región role=status de AuthShell");
+
+// 2 · La espera arranca al montar.
+assert.equal(RESEND_WAIT_SECONDS, 60);
+assert.match(
+  sinComentarios,
+  /initialSeconds=\{RESEND_WAIT_SECONDS\}/u,
+  "el botón de reenvío cuenta 60 s desde que aparece la pantalla",
+);
+
+// 3 · Sin reenvío automático.
+assert.doesNotMatch(sinComentarios, /useEffect/u, "ningún efecto: sólo un clic humano reenvía");
+const llamadas = sinComentarios.match(/resendVerification\(/gu) ?? [];
+assert.equal(llamadas.length, 1, "un único llamador de resendVerification");
+const indiceOnResend = sinComentarios.indexOf("onResend=");
+const indiceLlamada = sinComentarios.indexOf("resendVerification(");
+assert.ok(indiceOnResend !== -1 && indiceLlamada > indiceOnResend, "la llamada vive dentro de onResend");
+
+// El botón de reenvío: `initialSeconds` existe y arranca el contador.
+const boton = readFileSync("src/components/ResendTimerButton.tsx", "utf8");
+assert.match(boton, /initialSeconds = 0/u, "por defecto el botón nace activo (otras pantallas)");
+assert.match(boton, /useState\(initialSeconds\)/u, "la cuenta atrás inicial es el estado de partida");
+
+console.log(
