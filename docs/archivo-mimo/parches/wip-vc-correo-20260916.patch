--- /dev/null
+++ b/apps/web/src/lib/check-your-inbox.ts
@@ -0,0 +1,39 @@
+/**
+ * Lo que dice la pantalla «Revisa tu correo» tras crear la cuenta, y cuánto
+ * espera el botón de reenvío. Vive fuera del componente para que las
+ * pruebas de texto no necesiten DOM y para que los contratos que otras
+ * suites esperan queden a la vista:
+ *
+ *   · «Cuenta creada» lo buscan las suites reales (`free-launch-funnel`,
+ *     `jornada-real`, …) en la región `role="status"`. No se reformula.
+ *   · La frase principal dice QUÉ hacer —abrir el correo para activar la
+ *     cuenta— y DÓNDE mirar si no aparece (correo no deseado). Antes prometía
+ *     «entrarás directo», y no era verdad: tras verificar hay que iniciar
+ *     sesión.
+ */
+export const INBOX_COPY = {
+  created: "Cuenta creada.",
+  sentTo: "Te enviamos un correo a",
+  action:
+    "; ábrelo para activar tu cuenta (mira también en correo no deseado).",
+  /**
+   * Tras reenviar. Desde que el API acumula los enlaces de verificación
+   * (cada uno de un solo uso hasta caducar), el correo anterior NO se
+   * invalida, y la pantalla lo dice para que nadie tire el primero.
+   */
+  resent:
+    "Enviamos otro correo; los anteriores siguen valiendo hasta caducar.",
+  /** El correo tarda: se encola y se reintenta. */
+  patience: "Tarda hasta un par de minutos: el envío se encola y se reintenta.",
+} as const;
+
+/**
+ * Cuánto espera el botón «Enviar otro correo» DESDE QUE APARECE la pantalla.
+ *
+ * Antes estaba activo desde el segundo cero y el clic reflejo —«no llega,
+ * pulso»— era exactamente lo que producía dos correos en el mismo minuto.
+ * Sesenta segundos es lo que tarda en llegar un correo normal; el botón dice
+ * cuánto falta, así que la espera está explicada. No hay reenvío automático:
+ * sólo envía un clic humano.
+ */
+export const RESEND_WAIT_SECONDS = 60;
