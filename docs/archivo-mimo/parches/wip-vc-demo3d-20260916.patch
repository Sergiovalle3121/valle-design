@@ -0,0 +1,99 @@
+/**
+ * `cadDocument3dExtents`: la envolvente del MODELO, con cota.
+ *
+ * Con sólidos o muros visibles, la envolvente es la de ellos (y no la de los
+ * planos 2D que los rodean); sin volumen, la 2D a cota cero. Las capas
+ * apagadas y congeladas quedan fuera igual que en `cadDocumentExtents`, y un
+ * sólido cuyo árbol no construye no aporta nada en vez de tumbar la pregunta.
+ */
+import { check, checkClose, report } from "../../brep/spec-support";
+import { CAD_DOCUMENT_SCHEMA, type CadDocument, type CadEntity } from "../cad-document";
+import type { CadSolid3dEntity } from "../cad-entities-v5";
+import { cadDocument3dExtents, cadDocumentExtents } from "./document-extents";
+
+function documentWith(entities: readonly CadEntity[], layers: CadDocument["layers"] = []): CadDocument {
+  return {
+    meta: { version: 1, schema: CAD_DOCUMENT_SCHEMA, unit: "mm" },
+    layers: [{ id: "0", name: "0", color: "#ffffff", visible: true, locked: false }, ...layers],
+    entities: [...entities],
+    history: [],
+    modelSpace: { entityIds: entities.map((entity) => entity.id) },
+    paperSpaces: [],
+    styles: { text: {}, dimension: {}, table: {}, plot: {} },
+    blocks: [],
+    constraints: [],
+    externalReferences: [],
+    unsupportedEntities: [],
+    lossManifest: [],
+    publications: [],
+  };
+}
+
+const box = (id: string, layer: string, min: [number, number, number], max: [number, number, number]): CadSolid3dEntity => ({
+  id,
+  type: "solid3d",
+  layer,
+  root: "caja",
+  nodes: [{ id: "caja", op: "box", min: { x: min[0], y: min[1], z: min[2] }, max: { x: max[0], y: max[1], z: max[2] } }],
+});
+const line: CadEntity = { id: "l", type: "line", start: { x: -500, y: -500, z: 0 }, end: { x: 9000, y: 9000, z: 0 }, layer: "0" };
+
+// --- con sólidos, la envolvente es la de los sólidos y trae la Z -----------------
+{
+  const extents = cadDocument3dExtents(documentWith([line, box("a", "0", [0, 0, 0], [100, 200, 300]), box("b", "0", [50, 50, -20], [400, 100, 10])]));
+  check("hay envolvente", extents !== null);
+  if (extents) {
+    checkClose("minX de los sólidos, no de la línea", extents.minX, 0);
+    checkClose("maxX", extents.maxX, 400);
+    checkClose("minY", extents.minY, 0);
+    checkClose("maxY", extents.maxY, 200);
+    checkClose("minZ negativo del segundo sólido", extents.minZ, -20);
+    checkClose("maxZ del primero", extents.maxZ, 300);
+  }
+}
+
+// --- un muro cuenta como volumen: media anchura a cada lado y su altura ----------
+{
+  const wall: CadEntity = {
+    id: "m",
+    type: "wall",
+    start: { x: 0, y: 0, z: 0 },
+    end: { x: 1000, y: 0, z: 0 },
+    thickness: 200,
+    height: 2400,
+    layer: "0",
+  } as CadEntity;
+  const extents = cadDocument3dExtents(documentWith([line, wall]));
+  check("muro: envolvente", extents !== null);
+  if (extents) {
+    checkClose("muro: minY = −grosor/2", extents.minY, -100);
+    checkClose("muro: maxY = +grosor/2", extents.maxY, 100);
+    checkClose("muro: maxZ = altura", extents.maxZ, 2400);
+    checkClose("muro: maxX", extents.maxX, 1000);
+  }
+}
+
+// --- sin volumen, la 2D a cota cero -----------------------------------------------
+{
+  const document = documentWith([line]);
+  const flat = cadDocumentExtents(document);
+  const extents = cadDocument3dExtents(document);
+  check("plano: cae a la envolvente 2D", !!flat && !!extents && extents.minX === flat.minX && extents.maxY === flat.maxY);
+  check("plano: cota cero", !!extents && extents.minZ === 0 && extents.maxZ === 0);
+  check("vacío: null", cadDocument3dExtents(documentWith([])) === null);
+}
+
+// --- capas apagadas o congeladas no entran; un árbol roto no tumba la pregunta ----
+{
+  const layers: CadDocument["layers"] = [
+    { id: "OFF", name: "OFF", color: "#fff", visible: false, locked: false },
+    { id: "FRZ", name: "FRZ", color: "#fff", visible: true, locked: false, frozen: true },
+  ];
+  const roto: CadSolid3dEntity = { id: "r", type: "solid3d", layer: "0", root: "nada", nodes: [] };
+  const extents = cadDocument3dExtents(
+    documentWith([box("a", "0", [0, 0, 0], [10, 10, 10]), box("off", "OFF", [-900, 0, 0], [0, 0, 0]), box("frz", "FRZ", [0, 0, 0], [0, 900, 900]), roto], layers),
+  );
+  check("apagada y congelada fuera; el roto se salta", !!extents && extents.minX === 0 && extents.maxY === 10 && extents.maxZ === 10);
+}
+
+report("document-extents", 14);
