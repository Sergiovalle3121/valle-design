+/**
+ * Encuadra una caja de mundo (unidades de planta): centra el objetivo de la
+ * órbita en ella y aleja la cámara lo justo para que quepa en el FOV actual,
+ * conservando el ángulo de vista. Es el `fitToBounds` que vivía en el
+ * monolito, movido aquí sin cambiar un número: ZOOM Extensión, el encuadre
+ * de apertura (P0-3) y el conmutador 2D/3D lo llaman.
+ */
+export function fitCadCameraToBounds(
+  camera: THREE.PerspectiveCamera,
+  controls: OrbitControls,
+  ctx: CadCameraSceneContext,
+  b: CadWorldBounds,
+): void {
+  const { s, W, H } = ctx;
+  const cx = (b.minX + b.maxX) / 2,
+    cy = (b.minY + b.maxY) / 2;
+  const targetX = (cx - W / 2) * s,
+    targetZ = (cy - H / 2) * s;
+  const spanX = Math.max((b.maxX - b.minX) * s, s);
+  const spanZ = Math.max((b.maxY - b.minY) * s, s);
+  const fov = (camera.fov * Math.PI) / 180;
+  const aspect = camera.aspect || 1;
+  const fitForZ = spanZ / 2 / Math.tan(fov / 2);
+  const fitForX = spanX / 2 / Math.tan(fov / 2) / aspect;
+  const dist = Math.max(fitForZ, fitForX) * 1.25 + Math.max(spanX, spanZ) * 0.12;
+  const dir = new THREE.Vector3().subVectors(camera.position, controls.target);
+  if (dir.lengthSq() < 1e-6) dir.set(0.6, 0.85, 1.0);
+  dir.normalize().multiplyScalar(dist);
+  controls.target.set(targetX, 0, targetZ);
+  camera.position.set(targetX + dir.x, Math.max(dir.y, dist * 0.15), targetZ + dir.z);
+  controls.update();
+}
+
+/** Caja de mundo CON cota (unidades de dibujo). */
+export interface CadWorldBounds3d extends CadWorldBounds {
+  minZ: number;
+  maxZ: number;
+}
+
+/**
+ * Coloca la cámara en una de las diez vistas predefinidas (`CAD_STANDARD_VIEWS`,
+ * la isométrica SO verdadera incluida) encuadrando una envolvente 3D.
+ *
+ * A diferencia de los seis presets de la barra, que miran al origen de la
+ * huella a una distancia proporcional a ella, aquí el objetivo es el CENTRO de
+ * la envolvente —con su cota, que un modelo de dos plantas tiene— y la
+ * distancia la que hace caber su esfera envolvente en el FOV, en vertical y en
+ * horizontal. Es lo que ZOOM Extensión hace en 3D en cualquier CAD.
+ *
+ * El `up` de la cámara sigue siendo la vertical del mundo salvo en SUPERIOR e
+ * INFERIOR, donde la mirada es paralela a ella: OrbitControls razona en
+ * esféricas alrededor de `camera.up`, y un `up` inclinado (el de la tabla para
+ * las isométricas, ya ortogonalizado) le torcería cada órbita posterior.
+ * `lookAt` ortogonaliza por dentro y el encuadre en pantalla es el mismo.
+ */
+export function applyCadStandardViewFraming(
+  camera: THREE.PerspectiveCamera,
+  controls: OrbitControls,
+  ctx: CadCameraSceneContext,
+  viewId: CadStandardViewId,
+  extents: CadWorldBounds3d,
+): void {
+  const view = cadStandardView(viewId);
+  const { s, W, H } = ctx;
+  const target = new THREE.Vector3(
+    ((extents.minX + extents.maxX) / 2 - W / 2) * s,
+    ((extents.minZ + extents.maxZ) / 2) * s,
+    ((extents.minY + extents.maxY) / 2 - H / 2) * s,
+  );
+  const radius = Math.max(
+    (Math.hypot(extents.maxX - extents.minX, extents.maxY - extents.minY, extents.maxZ - extents.minZ) / 2) * s,
+    s,
+  );
+  const halfFov = (camera.fov * Math.PI) / 360;
+  const aspect = camera.aspect || 1;
+  const halfFovX = Math.atan(Math.tan(halfFov) * aspect);
+  const distance = (radius / Math.sin(Math.min(halfFov, halfFovX))) * 1.05;
+  const vertical = Math.abs(view.offset.y) > 0.999;
+  camera.up.set(vertical ? view.up.x : 0, vertical ? view.up.y : 1, vertical ? view.up.z : 0);
+  camera.position.set(
+    target.x + view.offset.x * distance,
+    target.y + view.offset.y * distance,
+    target.z + view.offset.z * distance,
+  );
+  camera.lookAt(target);
+  controls.target.copy(target);
+  controls.update();
+}
