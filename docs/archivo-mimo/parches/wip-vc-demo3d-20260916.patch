+/**
+ * `isCadOpeningPresentation`: el valor viaja como metadato y se valida como
+ * lo que es, un valor externo.
+ */
+import { check, report } from "../../brep/spec-support";
+import { isCadOpeningPresentation } from "./opening-presentation";
+
+check("la petición de la demostración es válida", isCadOpeningPresentation({ viewMode: "3d", standardView: "sw-iso", visualStyle: "shaded-edges" }));
+check("con proyección paralela también", isCadOpeningPresentation({ viewMode: "3d", standardView: "ne-iso", visualStyle: "shaded", projection: "parallel" }));
+check("viewMode 2d no es una presentación de apertura", !isCadOpeningPresentation({ viewMode: "2d", standardView: "top", visualStyle: "shaded" }));
+check("vista que no está en la tabla", !isCadOpeningPresentation({ viewMode: "3d", standardView: "iso", visualStyle: "shaded" }));
+check("estilo visual inexistente", !isCadOpeningPresentation({ viewMode: "3d", standardView: "top", visualStyle: "conceptual" }));
+check("proyección desconocida", !isCadOpeningPresentation({ viewMode: "3d", standardView: "top", visualStyle: "shaded", projection: "isometric" }));
+check("null, undefined y primitivos", !isCadOpeningPresentation(null) && !isCadOpeningPresentation(undefined) && !isCadOpeningPresentation("3d"));
+
+report("opening-presentation", 7);
