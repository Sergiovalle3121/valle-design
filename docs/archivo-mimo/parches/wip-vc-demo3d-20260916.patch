+/**
+ * `applyCadOpeningPresentation` con controles falsos: que ponga el modo 3D en
+ * React y en el controlador, aplique la política de cámara del 3D, encuadre la
+ * envolvente desde la vista pedida y lleve el estilo a los DOS anfitriones.
+ */
+import * as THREE from "three";
+import type { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
+import { check, checkPointClose, report } from "@/lib/brep/spec-support";
+import { applyCadOpeningPresentation } from "./opening-presentation";
+
+function fakeControls(): OrbitControls & { updateCalls: number } {
+  const controls = {
+    target: new THREE.Vector3(),
+    updateCalls: 0,
+    mouseButtons: { LEFT: THREE.MOUSE.ROTATE, MIDDLE: THREE.MOUSE.DOLLY, RIGHT: THREE.MOUSE.PAN },
+    touches: { ONE: THREE.TOUCH.ROTATE, TWO: THREE.TOUCH.DOLLY_PAN },
+    maxPolarAngle: 0.05,
+    minPolarAngle: 0,
+    enableRotate: false,
+    enableDamping: true,
+    zoomToCursor: false,
+    update: () => {
+      controls.updateCalls += 1;
+    },
+  };
+  return controls as unknown as OrbitControls & { updateCalls: number };
+}
+
+{
+  const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
+  const controls = fakeControls();
+  const calls: string[] = [];
+  const viewController = {
+    setMode: (mode: "2d" | "3d") => calls.push(`mode:${mode}`),
+    setProjection: (projection: "perspective" | "parallel") => calls.push(`projection:${projection}`),
+  };
+  const solidShadeHost = { setStyle: (style: string) => (calls.push(`solids:${style}`), style as "shaded") };
+  const nativeMassHosts = { applyVisualStyle: (style: string) => (calls.push(`masas:${style}`), style) };
+  applyCadOpeningPresentation({
+    camera,
+    controls,
+    ctx: { s: 1, W: 4, H: 3 },
+    viewController,
+    solidShadeHost,
+    nativeMassHosts,
+    extents: { minX: 1, minY: 1, maxX: 3, maxY: 2, minZ: 0, maxZ: 2 },
+    presentation: { viewMode: "3d", standardView: "sw-iso", visualStyle: "shaded-edges", projection: "parallel" },
+    setViewMode: (mode) => calls.push(`react:${mode}`),
+  });
+  check("React y controlador pasan a 3D antes que nada", calls[0] === "react:3d" && calls[1] === "mode:3d");
+  check("la política de cámara es la del 3D (órbita permitida, sin clavar en planta)", controls.enableRotate === true && controls.maxPolarAngle > 1);
+  checkPointClose("encuadra el centro de la envolvente con su cota", controls.target, { x: 0, y: 1, z: 0 });
+  const iso = 1 / Math.sqrt(3);
+  const dir = camera.position.clone().sub(controls.target).normalize();
+  checkPointClose("desde la isométrica SO verdadera", dir, { x: -iso, y: iso, z: -iso }, 1e-12);
+  check("la proyección pedida llega al controlador", calls.includes("projection:parallel"));
+  check("el estilo llega a los dos anfitriones, al final", calls.slice(-2).join(",") === "solids:shaded-edges,masas:shaded-edges");
+  check("controls.update() se llamó", controls.updateCalls >= 1);
+}
+
+{
+  // Sin envolvente (documento vacío) encuadra la huella; sin controlador ni anfitriones no revienta.
+  const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
+  const controls = fakeControls();
+  let mode = "2d";
+  applyCadOpeningPresentation({
+    camera,
+    controls,
+    ctx: { s: 1, W: 4, H: 3 },
+    viewController: null,
+    solidShadeHost: null,
+    nativeMassHosts: null,
+    extents: null,
+    presentation: { viewMode: "3d", standardView: "top", visualStyle: "shaded" },
+    setViewMode: (next) => (mode = next),
+  });
+  check("sin envolvente: el objetivo es el centro de la huella", controls.target.x === 0 && controls.target.z === 0);
+  check("el modo cambia igualmente", mode === "3d");
+}
+
+report("opening-presentation (viewport)", 9);
