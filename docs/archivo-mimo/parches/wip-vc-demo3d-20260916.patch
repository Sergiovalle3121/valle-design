+/**
+ * Aplica la PRESENTACIÓN DE APERTURA que pidió el puerto de documentos
+ * (`lib/cad/view/opening-presentation.ts`): modo 3D, una vista predefinida
+ * encuadrando la envolvente del modelo y un estilo visual en los dos
+ * anfitriones que sombrean (SOLID3D y muros/masas).
+ *
+ * Vive fuera del monolito por el presupuesto de líneas y porque no depende de
+ * React: recibe la cámara, los controles, el contexto de escena y los
+ * anfitriones, y deja el estado de React (el modo de vista) a un callback. Se
+ * puede montar en Node con controles falsos, que es como se prueba.
+ *
+ * El orden importa: la política de cámara del modo 3D se aplica ANTES del
+ * encuadre (`OrbitControls.update()` acota la elevación con `maxPolarAngle`,
+ * y la del 2D dejaría la cámara clavada en planta); el estilo va al final
+ * porque reconstruye mallas y no toca la cámara.
+ */
+import type * as THREE from "three";
+import type { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
+import type { CadOpeningPresentation } from "@/lib/cad/view/opening-presentation";
+import type { CadVisualStyleId } from "@/lib/cad/view/visual-styles";
+import { applyCadCameraPolicy } from "./camera-policy";
+import {
+  applyCadStandardViewFraming,
+  type CadCameraSceneContext,
+  type CadWorldBounds3d,
+} from "./camera-view-presets";
+
+/** Lo que la presentación necesita del controlador de vista, declarado estructuralmente. */
+export interface CadOpeningViewControllerLike {
+  setMode(mode: "2d" | "3d"): void;
+  setProjection?(projection: "perspective" | "parallel"): void;
+}
+
+export interface CadOpeningPresentationInput {
+  camera: THREE.PerspectiveCamera;
+  controls: OrbitControls;
+  ctx: CadCameraSceneContext;
+  viewController: CadOpeningViewControllerLike | null;
+  solidShadeHost: { setStyle(style: CadVisualStyleId): CadVisualStyleId } | null;
+  nativeMassHosts: { applyVisualStyle(style: CadVisualStyleId): string } | null;
+  extents: CadWorldBounds3d | null;
+  presentation: CadOpeningPresentation;
+  setViewMode(mode: "2d" | "3d"): void;
+}
+
+export function applyCadOpeningPresentation(input: CadOpeningPresentationInput): void {
+  const { presentation } = input;
+  input.setViewMode(presentation.viewMode);
+  input.viewController?.setMode(presentation.viewMode);
+  applyCadCameraPolicy(input.controls, presentation.viewMode);
+  const extents = input.extents ?? {
+    minX: 0,
+    minY: 0,
+    maxX: input.ctx.W,
+    maxY: input.ctx.H,
+    minZ: 0,
+    maxZ: 0,
+  };
+  applyCadStandardViewFraming(input.camera, input.controls, input.ctx, presentation.standardView, extents);
+  if (presentation.projection) input.viewController?.setProjection?.(presentation.projection);
+  input.solidShadeHost?.setStyle(presentation.visualStyle);
+  input.nativeMassHosts?.applyVisualStyle(presentation.visualStyle);
+}
