new file mode 100644
index 00000000..ca09568c
--- /dev/null
+++ b/apps/web/src/lib/cad/view/opening-presentation.ts
@@ -0,0 +1,37 @@
+/**
+ * PRESENTACIÓN DE APERTURA — lo que un documento pide al abrirse.
+ *
+ * El estudio arranca siempre en 2D porque el modo de vista sale de las
+ * preferencias del espacio de trabajo, no del documento. Un puerto de
+ * documentos (el de la demostración, hoy) puede devolver junto al documento
+ * ESTA petición: abrir en 3D, desde una de las diez vistas predefinidas, con
+ * un estilo visual concreto. El editor la aplica UNA vez por apertura y a
+ * partir de ahí manda el usuario.
+ *
+ * Es una hoja: sólo tipos y un validador. Viaja como metadato del recurso
+ * abierto, así que se valida como lo que es —un valor externo— y no se le
+ * cree por su forma en TypeScript.
+ */
+import { CAD_STANDARD_VIEWS, type CadStandardViewId } from "./view-3d";
+import { CAD_VISUAL_STYLES, type CadVisualStyleId } from "./visual-styles";
+
+export type CadOpeningProjection = "perspective" | "parallel";
+
+export interface CadOpeningPresentation {
+  viewMode: "3d";
+  standardView: CadStandardViewId;
+  visualStyle: CadVisualStyleId;
+  /** Sin él, la proyección vigente del visor (perspectiva). */
+  projection?: CadOpeningProjection;
+}
+
+const PROJECTIONS: readonly CadOpeningProjection[] = ["perspective", "parallel"];
+
+export function isCadOpeningPresentation(value: unknown): value is CadOpeningPresentation {
+  if (!value || typeof value !== "object") return false;
+  const candidate = value as Record<string, unknown>;
+  if (candidate.viewMode !== "3d") return false;
+  if (!CAD_STANDARD_VIEWS.some((view) => view.id === candidate.standardView)) return false;
+  if (!CAD_VISUAL_STYLES.some((style) => style.id === candidate.visualStyle)) return false;
+  return candidate.projection === undefined || PROJECTIONS.includes(candidate.projection as CadOpeningProjection);
+}
