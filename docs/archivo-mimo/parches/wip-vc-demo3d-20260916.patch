  * paralela se quedaría atrás en cuanto llegase un tipo nuevo.
  */
+import { bodyBounds } from "../../brep";
 import type { CadDocument } from "../cad-document";
 import { cadHiddenLayerIds } from "../cad-layer-visibility";
 import {
@@ -19,6 +20,7 @@ import {
   type CadBounds,
   type CadEntityRegistry,
 } from "../entity-runtime";
+import { solid3dBody } from "../solid3d-build";
 
 function merge(into: CadBounds | null, next: CadBounds): CadBounds {
   if (!into) return { ...next };
@@ -85,3 +87,76 @@ export function cadDocumentExtents(
   }
   return bounds;
 }
+
+/** Envolvente con cota: la XY de siempre más el intervalo en Z. */
+export interface CadBounds3d extends CadBounds {
+  minZ: number;
+  maxZ: number;
+}
+
+/**
+ * Envolvente del MODELO: lo que un encuadre 3D debe enseñar.
+ *
+ * Si el documento tiene entidades con volumen —sólidos SOLID3D o muros— en
+ * capas visibles, la envolvente es la de ELLAS, con su Z real: es lo que se
+ * sombrea y orbita, y encuadrar además los planos 2D que las rodean dejaría
+ * el modelo pequeño en una esquina. Sin volumen, es la envolvente 2D a cota
+ * cero, para que un encuadre 3D de un plano plano siga funcionando.
+ *
+ * Los sólidos se evalúan por `solid3dBody` (memoizado por la huella del árbol),
+ * así que preguntar por esto en cada apertura no reevalúa nada que la escena
+ * no haya evaluado ya. Un sólido cuyo árbol no construye se salta: el visor lo
+ * deja como grupo vacío y el encuadre no puede fiarse de él.
+ */
+export function cadDocument3dExtents(
+  document: CadDocument,
+  options: CadDocumentExtentsOptions = {},
+): CadBounds3d | null {
+  const hidden = options.hiddenLayerIds ?? cadHiddenLayerIds(document.layers);
+  let bounds: CadBounds3d | null = null;
+  const include = (next: CadBounds3d) => {
+    bounds = bounds
+      ? {
+          minX: Math.min(bounds.minX, next.minX),
+          minY: Math.min(bounds.minY, next.minY),
+          maxX: Math.max(bounds.maxX, next.maxX),
+          maxY: Math.max(bounds.maxY, next.maxY),
+          minZ: Math.min(bounds.minZ, next.minZ),
+          maxZ: Math.max(bounds.maxZ, next.maxZ),
+        }
+      : { ...next };
+  };
+  for (const entity of document.entities) {
+    if (entity.layer && hidden.has(entity.layer)) continue;
+    if (entity.type === "solid3d") {
+      try {
+        const box = bodyBounds(solid3dBody(entity));
+        include({ minX: box.min.x, minY: box.min.y, maxX: box.max.x, maxY: box.max.y, minZ: box.min.z, maxZ: box.max.z });
+      } catch {
+        // Un árbol que no construye no aporta envolvente; el visor tampoco lo dibuja.
+      }
+    } else if (entity.type === "wall" && entity.height > 0) {
+      // Media anchura a cada lado del eje, en PERPENDICULAR al muro: sumarla
+      // también a lo largo agrandaría la envolvente sin motivo.
+      const dx = entity.end.x - entity.start.x;
+      const dy = entity.end.y - entity.start.y;
+      const length = Math.hypot(dx, dy) || 1;
+      const nx = (-dy / length) * (entity.thickness / 2);
+      const ny = (dx / length) * (entity.thickness / 2);
+      const xs = [entity.start.x + nx, entity.start.x - nx, entity.end.x + nx, entity.end.x - nx];
+      const ys = [entity.start.y + ny, entity.start.y - ny, entity.end.y + ny, entity.end.y - ny];
+      const base = Math.min(entity.start.z, entity.end.z);
+      include({
+        minX: Math.min(...xs),
+        minY: Math.min(...ys),
+        maxX: Math.max(...xs),
+        maxY: Math.max(...ys),
+        minZ: base,
+        maxZ: base + entity.height,
+      });
+    }
+  }
+  if (bounds) return bounds;
+  const flat = cadDocumentExtents(document, options);
+  return flat ? { ...flat, minZ: 0, maxZ: 0 } : null;
+}
