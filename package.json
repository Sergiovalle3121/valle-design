{
  "name": "valle-design",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npx turbo run build",
    "dev": "npx turbo run dev",
    "doctor": "node scripts/doctor.mjs",
    "check:doctor": "node scripts/doctor.spec.mjs",
    "lint": "npx turbo run lint",
    "test": "npx turbo run test",
    "typecheck": "npx turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json && node -e \"const b=require('./sbom.cdx.json');console.log('SBOM OK:',b.components.length,'componentes')\"",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "check:cad-contract": "node scripts/cad/check-design-contract.mjs",
    "check:no-line-engineering": "node scripts/cad/check-no-line-engineering.mjs",
    "check:no-industrial-domain": "node scripts/cad/check-no-industrial-domain.spec.mjs && node scripts/cad/check-no-industrial-domain.mjs",
    "check:monolith-budget": "node scripts/cad/check-monolith-budget.mjs",
    "check:rubric": "node scripts/cad/rubric.mjs",
    "evidence:normas-mx": "node scripts/cad/mexican-drafting-standards-evidence.mjs",
    "check:normas-mx": "node scripts/cad/mexican-drafting-standards-evidence.mjs --check",
    "evidence:plot-fidelity": "node scripts/cad/plot-fidelity-evidence.mjs",
    "evidence:point-cloud-scale": "node scripts/cad/point-cloud-scale-evidence.mjs",
    "build:wasm-kernel": "node scripts/wasm/build-kernel.mjs",
    "check:wasm-kernel": "node scripts/wasm/build-kernel.mjs --check",
    "evidence:wasm-parity": "node scripts/wasm/wasm-parity-evidence.mjs",
    "evidence:dense-editing": "node scripts/cad/dense-editing-evidence.mjs",
    "evidence:touch-support": "node scripts/cad/touch-support-evidence.mjs",
    "evidence:api-load": "node scripts/cad/api-load-tests.mjs",
    "evidence:review-concurrency": "node scripts/cad/review-concurrency-evidence.mjs",
    "evidence:live-presence": "node scripts/cad/live-presence-evidence.mjs",
    "evidence:webhook-replay-audit": "node scripts/ops/webhook-replay-audit-evidence.mjs",
    "console:api": "node scripts/cad/build-api-console.mjs",
    "check:api-console": "node scripts/cad/build-api-console.mjs --check",
    "build:dxf-corpus": "node scripts/cad/build-dxf-external-corpus.mjs",
    "check:dxf-corpus": "node scripts/cad/build-dxf-external-corpus.mjs --check",
    "build:pdf-corpus": "node scripts/cad/build-pdf-import-corpus.mjs",
    "check:pdf-corpus": "node scripts/cad/build-pdf-import-corpus.mjs --check",
    "build:dxf-props": "node scripts/cad/build-dxf-property-matrix.mjs",
    "check:dxf-props": "node scripts/cad/build-dxf-property-matrix.mjs --check",
    "check:rubric:spec": "node scripts/cad/rubric.spec.mjs",
    "check:json-keys": "node scripts/cad/check-json-duplicate-keys.spec.mjs && node scripts/cad/check-json-duplicate-keys.mjs",
    "check:cad": "npm run check:json-keys && npm run check:doctor && npm run check:fonts && npm run check:contrast && npm run check:surface && npm run check:conventions && node scripts/cad/check-design-contract.mjs && node scripts/cad/check-no-line-engineering.mjs && npm run check:no-industrial-domain && node scripts/cad/check-monolith-budget.mjs && node scripts/cad/check-ribbon-coverage.mjs && node scripts/cad/ui-command-reach.mjs && node scripts/wasm/build-kernel.mjs --check && node scripts/cad/mexican-drafting-standards-evidence.mjs --check && npm run check:lint-budget && npm run check:dwg-evidence && npm run check:precision-evidence && npm run check:cad-math && npm run check:legal && npm run check:command-integrity && npm run check:e2e-localizadores && npm run check:authz && node scripts/cad/rubric.spec.mjs && node scripts/cad/rubric.mjs --markdown --check && npm run check:template-gallery && npm run check:dxf-corpus && npm run check:pdf-corpus && npm run check:dxf-props && npm run check:api-console",
    "evidence:dwg": "node scripts/dwg/dwg-evidence.mjs",
    "check:dwg-evidence": "node scripts/dwg/dwg-evidence.spec.mjs && node scripts/dwg/dwg-evidence.mjs --check",
    "probe:dwg-r2010-header": "node scripts/dwg/probe-r2010-object-header.mjs",
    "check:dwg-r2010-header": "node scripts/dwg/probe-r2010-object-header.mjs --check",
    "probe:dwg-r2010-body": "node scripts/dwg/probe-r2010-object-body.mjs",
    "check:dwg-r2010-body": "node scripts/dwg/probe-r2010-object-body.mjs --check",
    "probe:dwg-r2010-handles": "node scripts/dwg/probe-r2010-handle-stream.mjs",
    "check:dwg-r2010-handles": "node scripts/dwg/probe-r2010-handle-stream.mjs --check",
    "probe:dwg-r2010-strings": "node scripts/dwg/probe-r2010-string-stream.mjs",
    "check:dwg-r2010-strings": "node scripts/dwg/probe-r2010-string-stream.mjs --check",
    "probe:dwg-r2010-tablas": "node scripts/dwg/probe-r2010-table-fields.mjs",
    "check:dwg-r2010-tablas": "node scripts/dwg/probe-r2010-table-fields.mjs --check",
    "probe:dwg-capa-estado": "node scripts/dwg/probe-layer-state-flags.mjs",
    "check:dwg-capa-estado": "node scripts/dwg/probe-layer-state-flags.mjs --check",
    "probe:dwg-capa-ltype": "node scripts/dwg/probe-layer-linetype.mjs",
    "check:dwg-capa-ltype": "node scripts/dwg/probe-layer-linetype.mjs --check",
    "probe:dwg-3d-heredado": "node scripts/dwg/probe-3d-legacy-coverage.mjs",
    "check:dwg-3d-heredado": "node scripts/dwg/probe-3d-legacy-coverage.mjs --check",
    "probe:dwg-mtext": "node scripts/dwg/probe-mtext-fields.mjs",
    "check:dwg-mtext": "node scripts/dwg/probe-mtext-fields.mjs --check",
    "check:dwg-oraculo": "node scripts/dwg/check-oracle-evidence.mjs",
    "probe:dwg-r2010-cabecera": "node scripts/dwg/probe-r2010-header-variables.mjs",
    "check:dwg-r2010-cabecera": "node scripts/dwg/probe-r2010-header-variables.mjs --check",
    "evidence:precision": "node --import tsx apps/web/scripts/large-coordinate-precision-probe.mts docs/cad/evidence/large-coordinate-precision.json",
    "check:precision-evidence": "node scripts/cad/check-precision-evidence.mjs",
    "check:dwg": "npm run check --workspace=@valle-design/dwg-codec && node scripts/dwg/check-product-boundary.mjs && npm run check:dwg-corpus && npm run check:dwg-r2010-header && npm run check:dwg-r2010-body && npm run check:dwg-r2010-handles && npm run check:dwg-r2010-strings && npm run check:dwg-r2010-tablas && npm run check:dwg-r2010-cabecera && npm run check:dwg-capa-estado && npm run check:dwg-capa-ltype && npm run check:dwg-3d-heredado && npm run check:dwg-mtext && npm run check:dwg-oraculo",
    "corpus:dwg": "node scripts/dwg/fetch-corpus.mjs",
    "check:dwg-corpus": "node scripts/dwg/corpus-consumer.spec.mjs && node scripts/dwg/fetch-corpus.mjs --check",
    "check:deploy": "node scripts/deploy/validate-dockerfiles.spec.mjs && node scripts/deploy/validate-dockerfiles.mjs",
    "smoke:deploy": "node scripts/deploy/production-startup-smoke.spec.mjs && node scripts/deploy/production-startup-smoke.mjs",
    "ops:backup": "node scripts/ops/backup.mjs",
    "ops:restore-verify": "node scripts/ops/restore-verify.mjs",
    "ops:outbox-replay": "node scripts/ops/outbox-replay.mjs",
    "check:governance": "node scripts/check-proprietary-governance.mjs && node --test scripts/check-proprietary-governance.spec.mjs",
    "sbom:full": "npm sbom --sbom-format cyclonedx > sbom.full.cdx.json && node -e \"const b=require('./sbom.full.cdx.json');console.log('SBOM completo OK:',b.components.length,'componentes (runtime+dev)')\"",
    "check:e2e-localizadores": "node scripts/cad/check-e2e-localizadores.mjs",
    "check:command-integrity": "node scripts/cad/check-command-integrity.mjs",
    "check:authz": "node scripts/cad/check-handler-authorization.spec.mjs && node scripts/cad/check-handler-authorization.mjs",
    "check:legal": "node scripts/legal/check-legal-content.mjs",
    "check:fonts": "node scripts/check-self-hosted-fonts.mjs",
    "check:contrast": "node --test scripts/design/check-contrast.spec.mjs && node scripts/design/check-contrast.mjs",
    "check:surface": "node --test scripts/design/check-public-surface.spec.mjs && node scripts/design/check-public-surface.mjs",
    "check:lint-budget": "node scripts/check-lint-budget.mjs",
    "check:conventions": "node scripts/check-import-direction.mjs",
    "check:cad-math": "node scripts/cad/check-cad-math.mjs",
    "smoke:railway": "node scripts/deploy/railway-smoke.mjs",
    "check:lighthouse": "node --test scripts/perf/lighthouse-gate.spec.mjs && node scripts/perf/lighthouse-gate.mjs",
    "evidence:template-gallery": "node --import tsx apps/web/scripts/template-gallery-evidence.mts",
    "check:template-gallery": "node --import tsx apps/web/scripts/template-gallery-evidence.mts --check"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@redocly/cli": "2.47.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.18.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.12",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "@nestjs/core": "^11.2.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "rxjs": "^7.8.2"
  }
}
