{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    // TypeORM inicializa las entidades por reflexión (decoradores + DEFAULT
    // de columna), no en un constructor: la "asignación definitiva" que esta
    // flag exigiría vive en los decoradores. Activarla obligaría a ~146 `!`
    // decorativos en las entidades sin añadir una sola comprobación real.
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true
  }
}
