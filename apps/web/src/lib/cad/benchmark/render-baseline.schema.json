{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valle-design:schema:cad-render-baseline:v1",
  "title": "Valle Design CAD render pipeline baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entities",
          "panStops",
          "enforcement",
          "enforcementRationale",
          "hardware",
          "budgets",
          "invariants",
          "calibration"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "entities": { "type": "integer", "minimum": 1 },
          "panStops": { "type": "integer", "minimum": 1 },
          "enforcement": { "enum": ["blocking", "report-only"] },
          "enforcementRationale": { "type": "string", "minLength": 20 },
          "hardware": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumLogicalCpuCount", "minimumTotalMemoryBytes"],
            "properties": {
              "minimumLogicalCpuCount": { "type": "integer", "minimum": 1 },
              "minimumTotalMemoryBytes": { "type": "integer", "minimum": 1 }
            }
          },
          "budgets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nextFirstDetailMs",
              "nextZoomSettleMs",
              "nextPanFrameP95Ms",
              "nextPanFrameMaxMs",
              "leakHeapGrowthMb"
            ],
            "properties": {
              "nextFirstDetailMs": { "type": "number", "exclusiveMinimum": 0 },
              "nextZoomSettleMs": { "type": "number", "exclusiveMinimum": 0 },
              "nextPanFrameP95Ms": { "type": "number", "exclusiveMinimum": 0 },
              "nextPanFrameMaxMs": { "type": "number", "exclusiveMinimum": 0 },
              "leakHeapGrowthMb": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0
              }
            }
          },
          "invariants": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detailedEqualsVisibleAtRest",
              "minDetailedAtFullView",
              "maxLegacyDetailedAtFullView"
            ],
            "properties": {
              "detailedEqualsVisibleAtRest": { "const": true },
              "minDetailedAtFullView": { "type": "integer", "minimum": 1 },
              "maxLegacyDetailedAtFullView": { "type": "integer", "minimum": 1 }
            }
          },
          "calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runs",
              "marginFactor",
              "recordedAt",
              "environment",
              "observed"
            ],
            "properties": {
              "runs": { "type": "integer", "minimum": 3 },
              "marginFactor": { "type": "number", "minimum": 1 },
              "recordedAt": { "type": "string", "format": "date-time" },
              "environment": { "type": "object" },
              "observed": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
