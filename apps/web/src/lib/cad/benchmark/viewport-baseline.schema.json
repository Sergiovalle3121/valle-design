{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valle-design:schema:cad-viewport-baseline:v1",
  "title": "Valle Design CAD viewport experience baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entities", "gate", "target", "targetBlockedBy", "calibratedProjects", "calibration"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "entities": { "type": "integer", "minimum": 1 },
          "gate": { "$ref": "#/$defs/budget" },
          "target": { "$ref": "#/$defs/budget" },
          "targetBlockedBy": { "type": "string", "minLength": 10 },
          "calibratedProjects": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recordedAt", "runs", "marginFactor", "environment", "observed"],
            "properties": {
              "recordedAt": { "type": "string", "format": "date-time" },
              "runs": { "type": "integer", "minimum": 1 },
              "marginFactor": { "type": "number", "minimum": 1 },
              "environment": { "type": "object" },
              "observed": {
                "type": "object",
                "additionalProperties": { "type": "array", "items": { "type": "number" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalReadyMs",
        "detailReadyMs",
        "frameLatencyMs",
        "zoomReplanMs",
        "zoomSettleMs",
        "minDetailedFractionAtOpen",
        "minDetailedFractionAfterZoom"
      ],
      "properties": {
        "canonicalReadyMs": { "type": "number", "exclusiveMinimum": 0 },
        "detailReadyMs": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "frameLatencyMs": { "type": "number", "exclusiveMinimum": 0 },
        "zoomReplanMs": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "zoomSettleMs": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "minDetailedFractionAtOpen": { "type": "number", "minimum": 0, "maximum": 1 },
        "minDetailedFractionAfterZoom": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
