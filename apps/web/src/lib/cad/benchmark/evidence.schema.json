{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valle-design:schema:cad-benchmark-evidence:v1",
  "title": "Valle Design CAD benchmark evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "benchmarkId",
    "manifestSha256",
    "startedAt",
    "finishedAt",
    "environment",
    "run",
    "profiles",
    "scope"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "type": "string" },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "environment": { "type": "object" },
    "run": { "type": "object" },
    "profiles": { "type": "array" },
    "scope": {
      "type": "object",
      "required": ["measured", "notMeasured"],
      "properties": {
        "measured": { "type": "array", "items": { "type": "string" } },
        "notMeasured": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
