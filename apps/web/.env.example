# ── Valle Design · apps/web ────────────────────────────────────────────────
# Origen de la API de R1 (apps/api, puerto 4000 por defecto). El editor CAD
# construye sus URLs con esta variable (patrón del origen).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Alias aceptado por apiFetch para despliegues con la nomenclatura nueva.
# NEXT_PUBLIC_API_BASE=http://localhost:4000

# Login real: URL de la pantalla de login de VALLE Platform. Design NO tiene
# login propio; Platform devuelve al usuario con `#access_token=<jwt>`.
NEXT_PUBLIC_PLATFORM_LOGIN_URL=

# Marca (manifiesto compartido @axos/contracts — todas opcionales).
# NEXT_PUBLIC_BRAND_NAME=VALLE
# NEXT_PUBLIC_BRAND_LEGAL_ENTITY=Sergio Valle Enterprise Software
# NEXT_PUBLIC_BRAND_PRODUCT_NAME_DESIGN=Valle Design
