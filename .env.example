# Valle Design · configuración de referencia
# Copia únicamente las variables necesarias y conserva los secretos fuera de Git.

# PostgreSQL es obligatorio en producción. Sin DATABASE_URL/DB_HOST, sólo en
# desarrollo, la API usa SQLite local.
DATABASE_URL=postgres://valle:change-me@localhost:5432/valle_design_dev
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=valle
# DB_PASSWORD=change-me
# DB_DATABASE=valle_design_dev
# En PRODUCCIÓN el certificado PostgreSQL se VALIDA por defecto. Para un host
# sin CA verificable, la válvula de escape es explícita: DB_SSL_STRICT=false.
# Fuera de producción el estricto es opt-in con DB_SSL_STRICT=true.
# DB_SSL_STRICT=false
# Presupuestos de conexión (enteros positivos; los defaults sirven a la
# mayoría): tamaño del pool y timeouts por sesión de statement, transacción
# ociosa y espera de locks.
# DB_POOL_SIZE=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# SQLITE_PATH=dev.sqlite

# Blobs CAD en S3/MinIO (OPCIONAL). El adaptador S3 existe y se selecciona en
# RUNTIME (apps/api/src/modules/blob-store): con endpoint+bucket+credenciales
# válidos los blobs van al object storage; sin estas variables viven en
# PostgreSQL (design_blobs, bytea). Deciden dónde acaban los planos del
# cliente: trátalas como secretos. El endpoint exige HTTPS salvo hosts
# locales (el MinIO de docker-compose usa http://127.0.0.1:9000).
# S3_BLOB_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BLOB_BUCKET=valle-design-blobs
# S3_BLOB_REGION=us-east-1
# S3_BLOB_ACCESS_KEY_ID=<access-key>
# S3_BLOB_SECRET_ACCESS_KEY=<secret-key>
# S3_BLOB_SESSION_TOKEN=<solo-para-credenciales-temporales>
# S3_BLOB_PREFIX=valle/
# S3_BLOB_TIMEOUT_MS=10000
# S3_BLOB_FORCE_PATH_STYLE=true

# Producción: ambos valores son obligatorios; nunca uses synchronize.
# NODE_ENV=production
# SYNCHRONIZE=false
# MIGRATIONS_RUN=true

# HTTP y cookies first-party. En producción sirve web y API bajo una topología
# same-site/same-origin y configura el origen público exacto.
PORT=4000
# ALLOWED_ORIGIN=https://design.example.com

# Identidad standalone. Este secreto HMAC compartido entre réplicas evita que
# correo/IP aparezcan en claro en la tabla de rate limiting (mínimo 32 chars).
# IDENTITY_RATE_LIMIT_KEY_SECRET=<secret-random-de-32-o-mas-caracteres>

# Cifra en reposo el secreto del segundo factor (AES-256-GCM). OBLIGATORIA en
# producción y el arranque muere sin ella: sin clave propia el secreto TOTP se
# cifraría con la de desarrollo, que está en el repositorio, y un volcado de la
# base bastaría para descifrar todos los segundos factores (mínimo 32 chars).
# IDENTITY_MFA_ENCRYPTION_KEY=<secret-random-de-32-o-mas-caracteres>

# Trial creado con la primera organización (entero entre 1 y 90; default 14).
# TRIAL_DAYS=14

# Buzón que recibe comentarios (/v1/feedback) e incidentes (/v1/support).
# SIN esta variable los comentarios SE GUARDAN pero nadie recibe aviso — el
# API lo registra como advertencia en cada guardado.
# SUPPORT_EMAIL=soporte@example.com

# Nombre del emisor que muestra la app TOTP al inscribir el segundo factor
# (default: Valle Design).
# IDENTITY_MFA_ISSUER=Valle Design

# Quién puede leer los comentarios de TODOS en /comentarios/admin. Lista de
# correos separada por comas. NO hay rol de superadministrador en la base: los
# cuatro papeles son por organización y esa frontera protege el plano de un
# despacho del de otro. Falla CERRADO: sin esta variable no hay operadores.
# PRODUCT_OPERATOR_EMAILS=sergio@ejemplo.mx,soporte@ejemplo.mx

# Modo universitario. APAGADO por defecto y las dos variables son necesarias:
# sin la lista de dominios no hay ningún correo elegible ni con el modo
# encendido. Se aceptan el dominio y sus subdominios por segmentos de etiqueta
# (`alumnos.unam.mx` sí, `malicioso-unam.mx` no).
# EDUCATION_MODE=true
# EDUCATION_EMAIL_DOMAINS=unam.mx,uni.es

# Dispatcher transaccional. En producción OUTBOX_DISPATCHER_ENABLED debe ser
# true. Los dos receptores HTTPS pueden apuntar al mismo servicio; el cuerpo se
# firma con HMAC-SHA256 y lleva Idempotency-Key.
OUTBOX_DISPATCHER_ENABLED=false
# OUTBOX_EMAIL_WEBHOOK_URL=https://mailer.example.com/valle/outbox
# OUTBOX_DOMAIN_WEBHOOK_URL=https://events.example.com/valle/outbox
# OUTBOX_WEBHOOK_SECRET=<secret-random-de-32-o-mas-caracteres>
# OUTBOX_WEBHOOK_TIMEOUT_MS=15000
# OUTBOX_POLL_INTERVAL_MS=1000

# Receptor de outbox + envío de correo (ADR-0008). El receptor vive en esta
# misma API (POST /v1/outbox/email y /v1/outbox/domain) y verifica la firma
# con el mismo OUTBOX_WEBHOOK_SECRET del worker. El proveedor de correo se
# elige por configuración y jamás a medias: o las CUATRO variables, o
# ninguna. Sin ellas el receptor responde 503 y el correo espera en el
# outbox; a medias, el arranque FALLA a propósito — correo con enlaces rotos
# es peor que correo retrasado. OUTBOX_EMAIL_LINK_BASE_URL es el origen web
# público que ancla los enlaces absolutos de los correos (verify/reset).
# EMAIL_SENDER_PROVIDER=resend
# EMAIL_SENDER_API_KEY=re_...
# EMAIL_SENDER_FROM=Valle Design <no-responder@design.example.com>
# OUTBOX_EMAIL_LINK_BASE_URL=https://design.example.com

# Pasarela de pagos. O las CUATRO, o ninguna: sin ellas el cobro sigue siendo
# externo/asistido (adaptador nulo, checkout `external`); con las cuatro se
# activa la compra autoservicio con checkout hospedado y webhooks firmados.
# Una configuración a medias hace FALLAR el arranque a propósito: cobrar sin
# poder verificar el webhook es cobrar sin enterarse.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://design.example.com/billing/success
# STRIPE_CHECKOUT_CANCEL_URL=https://design.example.com/billing/cancel
# STRIPE_API_BASE_URL=https://api.stripe.com
# STRIPE_API_VERSION=2026-01-15
# STRIPE_TIMEOUT_MS=20000
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Vuelta desde el portal del cliente (E4). Opcional: sin ella se usa la URL de
# éxito del checkout, que ya sabe leer el estado real de la suscripción.
# STRIPE_PORTAL_RETURN_URL=https://design.example.com/cuenta/facturacion

# PAC para el CFDI 4.0. Sin estas variables el producto captura y valida los
# datos fiscales y el CFDI lo emite una persona (modo `manual`, y la interfaz
# lo dice). Con CFDI_PAC_NAME=facturama se enchufa el adaptador real: el job
# del outbox timbra cada cobro confirmado (nominativo con RFC; pool + factura
# global mensual XAXX010101000 sin datos fiscales). Un PAC desconocido sigue
# haciendo FALLAR el arranque. CFDI_PAC_API_KEY para Facturama es
# "usuario:contraseña" de la cuenta (Basic auth).
# CFDI_PAC_NAME=facturama
# CFDI_PAC_API_KEY=usuario:contrasena
# CFDI_ISSUER_RFC=...
# CFDI_ISSUER_TAX_REGIME=601
# Obligatoria con facturama: CP del emisor (ExpeditionPlace del comprobante).
# CFDI_ISSUER_POSTAL_CODE=06700
# Origen de la API del PAC; default el sandbox público de Facturama.
# CFDI_PAC_BASE_URL=https://apisandbox.facturama.mx
# Forma de pago SAT (default 31 = intermediario de pagos) y clave de
# producto/servicio (default 81161501) — confírmalas con el contador.
# CFDI_PAYMENT_FORM=31
# CFDI_PRODUCT_CODE=81161501

# Harness de correo exclusivo para test/local. Nunca se habilita en producción
# y exige destinatario exacto, tenant exacto cuando aplica y clave >=32 chars.
IDENTITY_TEST_HARNESS=false
# IDENTITY_TEST_HARNESS_KEY=<clave-de-test-de-32-o-mas-caracteres>

# Vigencia default de review links (minutos; 5 a 129600, default 10080).
# REVIEW_LINK_TTL_MINUTES=10080


# Llamadas WebRTC (/v1/calls/*). Sin CALLS_STUN_URLS el default son los STUN
# públicos de Google. Sin CALLS_TURN_URLS no hay TURN: las llamadas entre
# redes que no atraviesan NAT directo (~15%) fallan, declarándolo
# (turnConfigured: false) en vez de quedarse "conectando" para siempre.
# CALLS_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# CALLS_TURN_URLS=turn:turn.ejemplo.mx:3478
# CALLS_TURN_USERNAME=
# CALLS_TURN_CREDENTIAL=

# Servidor HTTP y apagado ordenado. keepAlive DEBE superar el idle timeout del
# balanceador (60 s en ALB/nginx) o aparecerán 502 esporádicos sin rastro en la
# aplicación; el techo de apagado debe quedar por debajo del stopTimeout del
# orquestador (30 s) para terminar por decisión propia y no por SIGKILL.
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
# HTTP_HEADERS_TIMEOUT_MS=70000
# HTTP_REQUEST_TIMEOUT_MS=120000
# SHUTDOWN_DRAIN_DELAY_MS=5000
# SHUTDOWN_GRACE_MS=25000

# Observabilidad. Ambas están DESACTIVADAS por omisión: sin METRICS_TOKEN el
# endpoint /metrics responde 404 (no 401), y sin SENTRY_DSN el reporte de
# errores usa el adaptador inerte, que no hace red.
# METRICS_TOKEN=<token-de-16-o-mas-caracteres-para-el-scrapper>
# SENTRY_DSN=https://<clave-publica>@<host>/<proyecto>
# RELEASE_VERSION=v0.1.0

# Gates PostgreSQL.
# TEST_DATABASE_URL=postgres://valle:change-me@localhost:5432/valle_design_test
# REQUIRE_POSTGRES_TESTS=true
# DATABASE_URL_SOURCE=postgres://...
# DATABASE_URL_TARGET=postgres://...

# Web. En producción se recomienda un proxy same-origin hacia la API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_API_BASE=http://localhost:4000

# Origen público canónico del sitio (sitemap, OG/social cards, JSON-LD).
# NEXT_PUBLIC_SITE_URL=https://design.example.com
# Modo de lanzamiento del sitio comercial y demo pública sin cuenta.
# NEXT_PUBLIC_LAUNCH_MODE=free-launch
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_PRICING_URL=https://example.com/precios
# Versión mostrada en el pie y en diagnósticos (la fija el build/release).
# NEXT_PUBLIC_APP_VERSION=0.1.0
# Beta de importación DWG (import-only; ver ADR-0009). APAGADAS por defecto
# en producción pública: AC1015 con la primera, AC1018 exige ADEMÁS la
# segunda. La tercera (perfil 3D heredado, §9) no tiene efecto todavía aunque
# se encienda: el titular no ha firmado esa autorización.
# NEXT_PUBLIC_DWG_NATIVE_IMPORT_BETA=false
# NEXT_PUBLIC_DWG_AC1018_IMPORT_BETA=false
# NEXT_PUBLIC_DWG_3D_WIREFRAME_IMPORT_BETA=false
# Familia MODERNA (AC1024/AC1027/AC1032, o sea AutoCAD 2010/2013/2018).
# El códec las lee con cero discrepancias, pero encenderla NO habilita
# nada: falta la firma del titular para esta familia.
# NEXT_PUBLIC_DWG_MODERN_IMPORT_BETA=false

# Enlaces públicos opcionales; sin ellos se usan páginas locales reales.
# NEXT_PUBLIC_SALES_URL=https://example.com/demo
# NEXT_PUBLIC_DOCUMENTATION_URL=https://docs.example.com
# NEXT_PUBLIC_SUPPORT_URL=https://example.com/support
# NEXT_PUBLIC_STATUS_URL=https://status.example.com
# NEXT_PUBLIC_CONTACT_URL=https://example.com/contact
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms
# NEXT_PUBLIC_LICENSES_URL=https://example.com/licenses

# Marca opcional.
# NEXT_PUBLIC_BRAND_NAME=VALLE
# NEXT_PUBLIC_BRAND_LEGAL_ENTITY=Sergio Valle Enterprise Software
# NEXT_PUBLIC_BRAND_PRODUCT_NAME_DESIGN=Valle Design
# NEXT_PUBLIC_BRAND_DESCRIPTOR=CAD 2D profesional en el navegador
# NEXT_PUBLIC_BRAND_TAGLINE_ES=Dibuja planos profesionales
# NEXT_PUBLIC_BRAND_TAGLINE_EN=Draw professional plans
# NEXT_PUBLIC_BRAND_FOUNDER=Sergio Valle Zarate
# NEXT_PUBLIC_BRAND_COPYRIGHT=Sergio Valle Enterprise Software
# NEXT_PUBLIC_BRAND_COPYRIGHT_YEAR=2026
# NEXT_PUBLIC_BRAND_TRADEMARK_SYMBOL=
# NEXT_PUBLIC_BRAND_TRADEMARK_STATUS=
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=soporte@example.com
# NEXT_PUBLIC_BRAND_SALES_EMAIL=ventas@example.com
# NEXT_PUBLIC_BRAND_PRIVACY_EMAIL=privacidad@example.com
# NEXT_PUBLIC_BRAND_WEBSITE_URL=https://example.com
# NEXT_PUBLIC_BRAND_LOGO_MARK=/brand/logo-mark.svg
# NEXT_PUBLIC_BRAND_LOGO_ICON=/brand/logo-icon.svg
