# Valle Design · configuración de referencia
# Copia únicamente las variables necesarias y conserva los secretos fuera de Git.

# PostgreSQL es obligatorio en producción. Sin DATABASE_URL/DB_HOST, sólo en
# desarrollo, la API usa SQLite local.
DATABASE_URL=postgres://valle:change-me@localhost:5432/valle_design_dev
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=valle
# DB_PASSWORD=change-me
# DB_DATABASE=valle_design_dev
# DB_SSL_STRICT=false
# SQLITE_PATH=dev.sqlite

# Producción: ambos valores son obligatorios; nunca uses synchronize.
# NODE_ENV=production
# SYNCHRONIZE=false
# MIGRATIONS_RUN=true

# HTTP y cookies first-party. En producción sirve web y API bajo una topología
# same-site/same-origin y configura el origen público exacto.
PORT=4000
# ALLOWED_ORIGIN=https://design.example.com

# Identidad standalone. Este secreto HMAC compartido entre réplicas evita que
# correo/IP aparezcan en claro en la tabla de rate limiting (mínimo 32 chars).
# IDENTITY_RATE_LIMIT_KEY_SECRET=<secret-random-de-32-o-mas-caracteres>

# Trial creado con la primera organización (entero entre 1 y 90; default 14).
# TRIAL_DAYS=14

# Dispatcher transaccional. En producción OUTBOX_DISPATCHER_ENABLED debe ser
# true. Los dos receptores HTTPS pueden apuntar al mismo servicio; el cuerpo se
# firma con HMAC-SHA256 y lleva Idempotency-Key.
OUTBOX_DISPATCHER_ENABLED=false
# OUTBOX_EMAIL_WEBHOOK_URL=https://mailer.example.com/valle/outbox
# OUTBOX_DOMAIN_WEBHOOK_URL=https://events.example.com/valle/outbox
# OUTBOX_WEBHOOK_SECRET=<secret-random-de-32-o-mas-caracteres>
# OUTBOX_WEBHOOK_TIMEOUT_MS=15000
# OUTBOX_POLL_INTERVAL_MS=1000

# Pasarela de pagos. O las CUATRO, o ninguna: sin ellas el cobro sigue siendo
# externo/asistido (adaptador nulo, checkout `external`); con las cuatro se
# activa la compra autoservicio con checkout hospedado y webhooks firmados.
# Una configuración a medias hace FALLAR el arranque a propósito: cobrar sin
# poder verificar el webhook es cobrar sin enterarse.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://design.example.com/billing/success
# STRIPE_CHECKOUT_CANCEL_URL=https://design.example.com/billing/cancel
# STRIPE_API_BASE_URL=https://api.stripe.com
# STRIPE_API_VERSION=2026-01-15
# STRIPE_TIMEOUT_MS=20000
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Harness de correo exclusivo para test/local. Nunca se habilita en producción
# y exige destinatario exacto, tenant exacto cuando aplica y clave >=32 chars.
IDENTITY_TEST_HARNESS=false
# IDENTITY_TEST_HARNESS_KEY=<clave-de-test-de-32-o-mas-caracteres>

# Vigencia default de review links (minutos; 5 a 129600, default 10080).
# REVIEW_LINK_TTL_MINUTES=10080

# IA opcional. Sin CIDE_BASE_URL, intent/vision responde available:false.
# CIDE_BASE_URL=http://localhost:11434/v1
# CIDE_API_KEY=
# CIDE_MODEL=qwen2.5:7b
# CIDE_VISION_MODEL=qwen2.5vl:7b
# CIDE_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=700
# AI_MOCK=1

# Servidor HTTP y apagado ordenado. keepAlive DEBE superar el idle timeout del
# balanceador (60 s en ALB/nginx) o aparecerán 502 esporádicos sin rastro en la
# aplicación; el techo de apagado debe quedar por debajo del stopTimeout del
# orquestador (30 s) para terminar por decisión propia y no por SIGKILL.
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
# HTTP_HEADERS_TIMEOUT_MS=70000
# HTTP_REQUEST_TIMEOUT_MS=120000
# SHUTDOWN_DRAIN_DELAY_MS=5000
# SHUTDOWN_GRACE_MS=25000

# Observabilidad. Ambas están DESACTIVADAS por omisión: sin METRICS_TOKEN el
# endpoint /metrics responde 404 (no 401), y sin SENTRY_DSN el reporte de
# errores usa el adaptador inerte, que no hace red.
# METRICS_TOKEN=<token-de-16-o-mas-caracteres-para-el-scrapper>
# SENTRY_DSN=https://<clave-publica>@<host>/<proyecto>
# RELEASE_VERSION=v0.1.0

# Gates PostgreSQL.
# TEST_DATABASE_URL=postgres://valle:change-me@localhost:5432/valle_design_test
# REQUIRE_POSTGRES_TESTS=true
# DATABASE_URL_SOURCE=postgres://...
# DATABASE_URL_TARGET=postgres://...

# Web. En producción se recomienda un proxy same-origin hacia la API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_API_BASE=http://localhost:4000

# Enlaces públicos opcionales; sin ellos se usan páginas locales reales.
# NEXT_PUBLIC_SALES_URL=https://example.com/demo
# NEXT_PUBLIC_DOCUMENTATION_URL=https://docs.example.com
# NEXT_PUBLIC_SUPPORT_URL=https://example.com/support
# NEXT_PUBLIC_STATUS_URL=https://status.example.com
# NEXT_PUBLIC_CONTACT_URL=https://example.com/contact
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms
# NEXT_PUBLIC_LICENSES_URL=https://example.com/licenses

# Marca opcional.
# NEXT_PUBLIC_BRAND_NAME=VALLE
# NEXT_PUBLIC_BRAND_LEGAL_ENTITY=Sergio Valle Enterprise Software
# NEXT_PUBLIC_BRAND_PRODUCT_NAME_DESIGN=Valle Design
