# ─────────────────────────────────────────────────────────────────────────────
# Valle Design — variables de entorno (apps/api)
# Copia este archivo a `.env` (o exporta las variables) según tu entorno.
# TODAS las variables listadas las lee realmente el código (grep process.env).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Sin DATABASE_URL ni DB_HOST el API cae a SQLite local (apps/api/dev.sqlite,
# cero setup, git-ignored). Con docker-compose:
DATABASE_URL=postgres://valle:valle@localhost:5432/valle_design_dev
# Alternativa por variables individuales (en vez de DATABASE_URL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=valle
# DB_PASSWORD=valle
# DB_DATABASE=valle_design_dev
# SSL estricto SOLO con CA verificable (por defecto relajado en PaaS):
# DB_SSL_STRICT=false
# Ruta alternativa del archivo SQLite de dev:
# SQLITE_PATH=dev.sqlite

# En PRODUCCIÓN es obligatorio declarar explícitamente:
# SYNCHRONIZE=false
# Aplicar migraciones al arrancar también fuera de prod:
# MIGRATIONS_RUN=true

# ── Autenticación (tokens emitidos por Platform) ─────────────────────────────
# Design VERIFICA los JWT de sesión de Platform con un secreto compartido vía
# entorno (consumo por contrato; nunca import de código). JWT_SECRET tiene
# prioridad; SESSION_SECRET es el alias de los despliegues de Platform con un
# único secreto de sesión. En producción es OBLIGATORIO (>= 16 caracteres);
# en dev cae a un default inseguro explícito.
JWT_SECRET=cambia-este-secreto-compartido-con-platform
# SESSION_SECRET=

# ── Entitlements (acceso comercial design.cad) ───────────────────────────────
# allow-all    → todo tenant autenticado tiene design.cad (DEFAULT en dev).
# platform-api → la autoridad es la API de Platform (Fase 5:
#                PlatformEntitlementClient, cliente HTTP REAL del contrato
#                specs/platform-api.v1.yaml — GET /v1/entitlements/design.cad
#                con el bearer del request reenviado). FAIL-CLOSED: sin URL,
#                timeout, red caída o respuesta no-200 ⇒ se niega.
#                En producción el default es platform-api.
ENTITLEMENTS_MODE=allow-all
# Host de la API de Platform (obligatorio en modo platform-api; el switch a
# la Platform productiva es apuntar esta URL — el contrato ya está
# implementado y probado contra un servidor del contrato):
# PLATFORM_API_URL=https://platform.api.interno
# Timeout corto de la consulta (ms; default 1500):
# ENTITLEMENTS_TIMEOUT_MS=1500
# Caché breve por tenant (ms; default 30000; 0 = sin caché):
# ENTITLEMENTS_CACHE_TTL_MS=30000

# ── Review links (Fase 5) ────────────────────────────────────────────────────
# Vigencia por defecto del review link en minutos (default 10080 = 7 días;
# el creador puede pedir otra por request, acotada 5 min – 90 días):
# REVIEW_LINK_TTL_MINUTES=10080

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=4000
# Orígenes CORS permitidos (coma-separados). En dev, sin definirla, se
# permiten localhost:3000/3001.
# ALLOWED_ORIGIN=https://design.tudominio.com

# ── Motor de IA CIDE (opcional — NL→CAD y Vision→CAD) ────────────────────────
# Sin CIDE_BASE_URL los servicios de intent/vision degradan con gracia
# (available:false); no es necesario para arrancar.
# CIDE_BASE_URL=http://localhost:11434/v1
# CIDE_API_KEY=
# CIDE_MODEL=qwen2.5:7b
# CIDE_VISION_MODEL=qwen2.5vl:7b
# CIDE_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=700
# Modo mock determinista para pruebas/CI (sin red):
# AI_MOCK=1

# ── Pruebas ──────────────────────────────────────────────────────────────────
# Suites *.pg.spec.ts (concurrencia/atomicidad sobre PostgreSQL real):
# TEST_DATABASE_URL=postgres://valle:valle@localhost:5432/valle_design_test
# En CI, convierte la ausencia de base en fallo (no en salto silencioso):
# REQUIRE_POSTGRES_TESTS=true

# ── MinIO (docker-compose; blobs S3 FUTUROS) ─────────────────────────────────
# HOY los blobs CAD viven en la base (tabla design_blobs). MinIO queda
# levantado para el adaptador S3 de una fase posterior; el API aún no lee
# estas variables.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=valle
# S3_SECRET_KEY=valle-minio
# S3_BUCKET=valle-design-blobs

# Disabled-by-default, one-release bridge for old Platform browser handoffs.
LEGACY_PLATFORM_AUTH_ENABLED=false
NEXT_PUBLIC_LEGACY_PLATFORM_AUTH_ENABLED=false
