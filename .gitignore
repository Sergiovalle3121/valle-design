# SBOM: se REGENERA en cada verificación (`npm run sbom`). Versionarlo
# invitaría a revisar un artefacto obsoleto como si fuera la verdad.
sbom.cdx.json
sbom.full.cdx.json

# Sondas temporales de diagnóstico (zz-*): viven bajo e2e/ sólo porque
# Playwright exige su testDir; no son producto y no deben correr en CI.
apps/web/e2e/**/zz-*.spec.ts

# Salidas de Playwright y artefactos POR CORRIDA del estrés denso. Lo que se
# versiona es la evidencia agregada de `docs/cad/evidence/`, que sale de cruzar
# tres corridas; las corridas sueltas son insumo y caducan con la máquina.
apps/web/e2e/.artifacts/
apps/web/e2e/.report/
# Con comodín: las corridas con `--output` propio (.test-results-dense6, …)
# son igual de por-corrida que la carpeta por defecto.
apps/web/e2e/.test-results*/
# Cache local del corpus DWG descargado: bytes con derechos que NUNCA se
# versionan en este repositorio publico. El pin y los hashes si; los bytes no.
.cache/

# Dumps locales del ensayo de backup/restore (ops:backup) — nunca se versionan.
/backups/


# Informes de Lighthouse CI: son evidencia de una corrida, no del repo.
.lighthouseci*/
informes-lighthouse/
